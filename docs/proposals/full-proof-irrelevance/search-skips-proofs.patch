+/// [`same_shifted`] up to proofs, as the kernel compares (docs/core.md,
+/// "Proof irrelevance"): below a head that already matched, two arguments
+/// at a proof position are taken as the same without being looked at. The
+/// proof positions are a constructor's proof fields, a data type's proof
+/// parameters and a definition's inert arguments (spelt as an application
+/// of the definition). Nothing is skipped at the root: a needle that is a
+/// proof would otherwise match every proof (docs/proposals/
+/// full-proof-irrelevance-audit.md, finding E). Nor is an argument that
+/// mentions an unknown, which unification may still have to solve.
+///
+/// For searches that match a pattern against a candidate, where the head
+/// fixes the types of the arguments compared.
+pub(crate) fn same_shifted_but_proofs(
+    g: &Ev,
+    a: &Term,
+    b: &Term,
+    by: usize,
+    cutoff: usize,
+) -> bool {
+    same_in(Some(g), a, b, by, cutoff)
+}
+
+/// Two arguments at a proof position, compared by [`same_in`].
+fn same_proofs(g: Option<&Ev>, x: &Term, y: &Term, by: usize, cutoff: usize) -> bool {
+    let unknown = |t: &Term| t.subterms().any(|(t, _)| matches!(t, Term::Meta(_)));
+    same_in(g, x, y, by, cutoff) || (g.is_some() && !unknown(x) && !unknown(y))
+}
