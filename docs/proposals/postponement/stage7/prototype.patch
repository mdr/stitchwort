+/// SCRATCH (SW-988): an argument that is a proof search, checked last.
+fn is_tactic_arg(value: &Expr) -> bool {
+    match value {
+        Expr::Omega { .. } | Expr::Cases { .. } | Expr::Ring { .. } | Expr::Rewrite { .. } => true,
+        Expr::Var(name) => name.text == "rfl" && std::env::var("SCRATCH_RFL_LAST").is_ok(),
+        Expr::Bracketed(inner, _) => is_tactic_arg(inner),
+        _ => false,
+    }
