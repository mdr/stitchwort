+  /usr/bin/time -p env "$@" PQ_TERMS="$(cat target/pq/terms.txt)" PQ_OUT=target/pq/$name.txt timeout 1500 dev/memguard --cap-gb 2 -- "$bin" --ignored queue_measure 2>&1 | grep -E "test result|^(real|user|sys)|panicked|doesn't check" | head -8
