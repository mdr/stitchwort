+"""Scratch: compare the Y (type) lines of two queue_scratch outputs."""
+import sys
+
+
+def load(path):
+    out = {}
+    for line in open(path):
+        if line.startswith("Y "):
+            _, unit, rest = line.rstrip("\n").split(" ", 2)
+            # the path ends where the Debug text of the type begins
+            for head in ("Pi(", "Eq(", "Data(", "App(", "Sort(", "Def(", "Loc("):
+                i = rest.find(" " + head)
+                if i >= 0:
+                    break
+            out[(unit, rest[:i])] = rest[i + 1:]
+    return out
+
+
+a, b = load(sys.argv[1]), load(sys.argv[2])
+same = sum(1 for k in a if b.get(k) == a[k])
+diff = [k for k in a if k in b and b[k] != a[k]]
+print(f"  {sys.argv[1].split('/')[-1]}: {len(a)} types compared, {same} identical, {len(diff)} differ")
+for k in diff:
+    print(f"    differs: {k}")
