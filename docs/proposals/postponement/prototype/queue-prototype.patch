@@ -0,0 +1,142 @@
+//! EXPERIMENTAL scratch measurement for docs/proposals/postponement.md
+//! draft 2 (§11): what the queue prototype (`STITCHWORT_QUEUE=1`,
+//! `crates/elab/src/queue.rs`) changes. Writes, to the file `PQ_OUT`
+//! names, every declaration's hash and every example's outcome, for std,
+//! examples/{accept,reject,extract}, aoc and games/rogue. Run once with the
+//! switch off and once on, and compare.
+
+use std::fmt::Write as _;
+use std::path::Path;
+use std::time::Instant;
+
+use stitchwort_core::hash::{ContentHash, data_hash, def_hash};
+use stitchwort_core::{DataId, DefId};
+use stitchwort_driver::driver::Session;
+use stitchwort_driver::project::{DiskFiles, Target};
+
+fn show(h: stitchwort_core::budget::Result<Option<ContentHash>>) -> String {
+    match h {
+        Ok(Some(h)) => h.hex(),
+        _ => "<none>".to_string(),
+    }
+}
+
+fn hashes(session: &Session, unit: &str, data0: usize, def0: usize, out: &mut String) {
+    let g = &session.elab.globals;
+    let mut lines = Vec::new();
+    for i in data0..g.datas.len() {
+        lines.push(format!("H {unit} data {} {}", g.datas[i].path, show(data_hash(g, DataId(i)))));
+    }
+    let wanted: Vec<String> = std::env::var("PQ_TERMS")
+        .map(|v| v.split(',').map(str::to_string).collect())
+        .unwrap_or_default();
+    for i in def0..g.defs.len() {
+        lines.push(format!("H {unit} {} {}", g.defs[i].path, show(def_hash(g, DefId(i)))));
+        if wanted.iter().any(|w| *w == *g.defs[i].path)
+            && let Some(body) = g.defs[i].body()
+        {
+            let text = if std::env::var("PQ_DEBUG").is_ok() { format!("{body:?}") } else { stitchwort_core::pretty::term_in_full(g, &[], body).unwrap_or_else(|e| format!("<{e:?}>")) };
+            lines.push(format!("B {unit} {} {}", g.defs[i].path, text.replace('\n', " ")));
+            lines.push(format!("Y {unit} {} {:?}", g.defs[i].path, g.defs[i].ty));
+        }
+    }
+    lines.sort();
+    for l in lines {
+        out.push_str(&l);
+        out.push('\n');
+    }
+}
+
+fn outcome(unit: &str, r: &Result<impl Sized, Vec<stitchwort_syntax::Diagnostic>>, out: &mut String) {
+    match r {
+        Ok(_) => writeln!(out, "R {unit} OK").unwrap(),
+        Err(ds) => {
+            for d in ds.iter().filter(|d| d.severity == stitchwort_syntax::Severity::Error) {
+                let at = d
+                    .labels
+                    .first()
+                    .map(|l| format!("{}-{} {}", l.span.start, l.span.end, l.message.replace('\n', " ")))
+                    .unwrap_or_default();
+                writeln!(out, "R {unit} ERR {} | {} | {}", d.code, d.message.replace('\n', " "), at).unwrap();
+            }
+        }
+    }
+}
+
+thread_local! {
+    static LAST: std::cell::Cell<[usize; 4]> = const { std::cell::Cell::new([0; 4]) };
+}
+
+/// The queue's counters since the last call, if any moved.
+fn stats(session: &Session, unit: &str, out: &mut String) {
+    for (tag, n) in stitchwort_elab::queue_notes() {
+        writeln!(out, "N {unit} {tag} {n}").unwrap();
+    }
+    let now = session.elab.queue_stats();
+    let last = LAST.with(|l| l.replace(now));
+    if now != last {
+        let d: Vec<usize> = (0..4).map(|i| now[i] - last[i]).collect();
+        writeln!(out, "S {unit} queued {} resumed {} defaulted {} stuck {}", d[0], d[1], d[2], d[3]).unwrap();
+    }
+}
+
+fn run() {
+    let mut out = String::new();
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../");
+    let t = Instant::now();
+    let mut session = Session::eager_for_stack(512 * 1024 * 1024);
+    writeln!(out, "T std {:.2}", t.elapsed().as_secs_f64()).unwrap();
+    hashes(&session, "std", 0, 0, &mut out);
+    stats(&session, "std", &mut out);
+    let mark = session.mark();
+    let (data0, def0) = (session.elab.globals.datas.len(), session.elab.globals.defs.len());
+    for dir in ["accept", "reject", "extract"] {
+        let mut found: Vec<_> = std::fs::read_dir(root.join("examples").join(dir))
+            .unwrap()
+            .map(|e| e.unwrap().path())
+            .filter(|p| p.extension().is_some_and(|e| e == "sw"))
+            .filter(|p| {
+                std::env::var("PQ_ONLY")
+                    .map_or(true, |f| p.to_string_lossy().contains(&f))
+            })
+            .collect();
+        found.sort();
+        let t = Instant::now();
+        for path in &found {
+            session.rewind(&mark);
+            let unit = format!("{dir}/{}", path.file_name().unwrap().to_string_lossy());
+            let text = std::fs::read_to_string(path).unwrap();
+            let r = session.load(&path.display().to_string(), &text);
+            outcome(&unit, &r, &mut out);
+            stats(&session, &unit, &mut out);
+            if r.is_ok() {
+                hashes(&session, &unit, data0, def0, &mut out);
+            }
+        }
+        writeln!(out, "T examples/{dir} {:.2}", t.elapsed().as_secs_f64()).unwrap();
+    }
+    for (dir, name) in [(root.join("aoc"), "aoc"), (root.join("games/rogue"), "rogue")] {
+        if std::env::var("PQ_ONLY").is_ok_and(|f| f != name) {
+            continue;
+        }
+        session.rewind(&mark);
+        let t = Instant::now();
+        let r = session.load_project(&DiskFiles { root: dir }, name, &Target::Everything);
+        writeln!(out, "T {name} {:.2}", t.elapsed().as_secs_f64()).unwrap();
+        outcome(name, &r, &mut out);
+        stats(&session, name, &mut out);
+        hashes(&session, name, data0, def0, &mut out);
+    }
+    std::fs::write(std::env::var("PQ_OUT").unwrap(), out).unwrap();
+}
+
+#[test]
+#[ignore]
+fn queue_measure() {
+    std::thread::Builder::new()
+        .stack_size(1024 * 1024 * 1024)
+        .spawn(run)
+        .unwrap()
+        .join()
+        .unwrap();
+}
