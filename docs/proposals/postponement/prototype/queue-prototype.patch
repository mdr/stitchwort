+"""Scratch: for each B line in two outputs, show where the terms first differ."""
+import sys
+
+
+def load(path):
+    out = {}
+    for line in open(path):
+        if line.startswith("B "):
+            _, unit, rest = line.rstrip("\n").split(" ", 2)
+            name, _, text = rest.partition(" ")
+            # names may contain spaces (tests): match on the known prefix
+            out[(unit, rest[:200])] = rest
+    return out
+
+
+a, b = load(sys.argv[1]), load(sys.argv[2])
+ka = {k[0] + " " + v.split(" App(")[0].split(" Lam(")[0][:80]: v for k, v in a.items()}
+kb = {k[0] + " " + v.split(" App(")[0].split(" Lam(")[0][:80]: v for k, v in b.items()}
+for k in sorted(ka):
+    x, y = ka[k], kb.get(k)
+    if y is None or x == y:
+        print(f"== {k}: {'same' if x == y else 'missing'} ({len(x)} chars)")
+        continue
+    i = 0
+    while i < min(len(x), len(y)) and x[i] == y[i]:
+        i += 1
+    j = 0
+    while j < min(len(x), len(y)) - i and x[-1 - j] == y[-1 - j]:
+        j += 1
+    print(f"== {k}: differs ({len(x)} vs {len(y)} chars)")
+    print(f"   off: ...{x[max(0, i - 120):len(x) - j][:500]}...")
+    print(f"   on:  ...{y[max(0, i - 120):len(y) - j][:500]}...")
