+#!/bin/bash
+# Scratch: exact (Debug) terms of a few declarations, queue off and on.
+cd /Users/matt/repos/mdr/stitchwort/.claude/worktrees/agent-a90adb251a628a470
+bin=$(ls -t target/release/deps/queue_scratch-* | grep -v '\.d$' | head -1)
