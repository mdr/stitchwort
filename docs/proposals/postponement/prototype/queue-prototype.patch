+//! EXPERIMENTAL, off by default: a prototype of the single postponement
+//! queue of docs/proposals/postponement.md (draft 2, §11), switched on by
+//! the environment variable `STITCHWORT_QUEUE=1`. Only for measuring what
+//! the queue changes; not a design to keep.
+//!
+//! With it on, a record literal whose type is an unknown, and `.field` on a
+//! receiver whose type is an unknown, don't raise `E-CANNOT-INFER`: they
+//! become a placeholder unknown and a queued check, resumed when the
+//! unknown they wait for is solved (in the obligations loop, so at every
+//! `solve_obligations` and at the end of the declaration). A literal still
+//! waiting when nothing else makes progress takes its type from its field
+//! names (SW-805's rule, as a default). One still stuck after that is
+//! reported with the error its site would have raised.
+
+use std::rc::Rc;
+use std::sync::OnceLock;
+
+use stitchwort_core::value::{Head, force};
+use stitchwort_core::{Term, Value};
+use stitchwort_syntax::Diagnostic;
+use stitchwort_syntax::ast::{Expr, Name as AstName};
+
+use crate::Elaborator;
+use crate::check::{Arg, Ctx, Result, Saved};
+
+/// Whether the prototype is switched on.
+pub(crate) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("STITCHWORT_QUEUE").is_ok_and(|v| v == "1"))
+}
+
+/// Whether the end of each application is a resume point too
+/// (`STITCHWORT_QUEUE_APP=1`).
+pub(crate) fn at_applications() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    on() && *ON.get_or_init(|| std::env::var("STITCHWORT_QUEUE_APP").is_ok_and(|v| v == "1"))
+}
+
+/// Whether the queue is settled before lifting (`STITCHWORT_QUEUE_LIFT=1`).
+pub(crate) fn at_lift() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    on() && *ON.get_or_init(|| std::env::var("STITCHWORT_QUEUE_LIFT").is_ok_and(|v| v == "1"))
+}
+
+/// Whether SW-805's field-name rule runs at the literal, before queueing,
+/// when it finds one type (Agda's order), rather than only as a default
+/// (`STITCHWORT_QUEUE_NAMES_FIRST=1`).
+pub(crate) fn names_first() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    on() && *ON.get_or_init(|| std::env::var("STITCHWORT_QUEUE_NAMES_FIRST").is_ok_and(|v| v == "1"))
+}
+
+static NOTES: std::sync::Mutex<std::collections::BTreeMap<String, usize>> =
+    std::sync::Mutex::new(std::collections::BTreeMap::new());
+
+/// Counts one firing of an existing catch-and-retry path (with the switch
+/// off too), for the measurement.
+pub(crate) fn note(tag: String) {
+    *NOTES.lock().unwrap().entry(tag).or_insert(0) += 1;
+}
+
+/// The counts [`note`] made since the last call.
+pub fn take_notes() -> std::collections::BTreeMap<String, usize> {
+    std::mem::take(&mut *NOTES.lock().unwrap())
+}
+
+/// Whether an application's end resumes only the items made while the
+/// application was elaborated, as Lean's `withSynthesize` does
+/// (`STITCHWORT_QUEUE_SCOPED=1`).
+pub(crate) fn scoped() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    on() && *ON.get_or_init(|| std::env::var("STITCHWORT_QUEUE_SCOPED").is_ok_and(|v| v == "1"))
+}
+
+/// An argument of a queued dot call, owned.
+pub(crate) enum OwnedArg {
+    Explicit(Expr),
+    Named(AstName, Expr),
+    NamedExplicit(AstName, Expr),
+}
+
+pub(crate) enum Kind {
+    Record {
+        fields: Vec<(AstName, Expr)>,
+        expected: Value,
+    },
+    Dot {
+        recv: Expr,
+        field: AstName,
+        args: Vec<OwnedArg>,
+        rterm: Term,
+        rty: Value,
+        blocker: crate::dot::Blocker,
+        result: Value,
+    },
+}
+
+pub(crate) struct Item {
+    kind: Kind,
+    saved: Saved,
+    placeholder: Term,
+    /// What the site would have raised without the queue.
+    error: Diagnostic,
+}
+
+/// The queue of the current declaration, and which of its items have been
+/// resumed (by index, in the order they were): both are truncated by
+/// `Snapshot::restore`, so an attempt undone takes its items and its
+/// resumptions with it.
+#[derive(Default)]
+pub(crate) struct Queue {
+    pub items: std::cell::RefCell<Vec<Rc<Item>>>,
+    pub done: std::cell::RefCell<Vec<usize>>,
+    /// Counters, for STITCHWORT_QUEUE_STATS.
+    pub queued: std::cell::Cell<usize>,
+    pub resumed: std::cell::Cell<usize>,
+    pub defaulted: std::cell::Cell<usize>,
+    pub stuck: std::cell::Cell<usize>,
+}
+
+impl Queue {
+    pub(crate) fn clear(&self) {
+        self.items.borrow_mut().clear();
+        self.done.borrow_mut().clear();
+    }
+}
+
+fn push(cx: &Ctx, kind: Kind, placeholder: Term, error: Diagnostic) {
+    let q = &cx.e.queue;
+    q.queued.set(q.queued.get() + 1);
+    if std::env::var("STITCHWORT_QUEUE_TRACE").is_ok() {
+        eprintln!("queue: push #{} at {:?}: {}", q.items.borrow().len(), cx.span, error.message);
+    }
+    q.items.borrow_mut().push(Rc::new(Item {
+        kind,
+        saved: cx.save(),
+        placeholder,
+        error,
+    }));
+}
+
+/// A record literal at the unknown type `expected`, queued.
+pub(crate) fn record(
+    cx: &mut Ctx,
+    fields: &[(AstName, Expr)],
+    expected: &Value,
+    error: Diagnostic,
+) -> Result<Term> {
+    let placeholder = cx.fresh_meta();
+    push(
+        cx,
+        Kind::Record {
+            fields: fields.to_vec(),
+            expected: expected.clone(),
+        },
+        placeholder.clone(),
+        error,
+    );
+    Ok(placeholder)
+}
+
+/// `recv.field args` with the receiver's type unknown, queued; `None` if
+/// an argument is one the prototype can't keep.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn dot(
+    cx: &mut Ctx,
+    recv: &Expr,
+    field: &AstName,
+    args: &[Arg],
+    rterm: Term,
+    rty: Value,
+    blocker: crate::dot::Blocker,
+    error: Diagnostic,
+) -> Result<Option<(Term, Value)>> {
+    let mut owned = Vec::new();
+    for arg in args {
+        owned.push(match arg {
+            Arg::Explicit(e) => OwnedArg::Explicit((*e).clone()),
+            Arg::Named(n, e) => OwnedArg::Named((*n).clone(), (*e).clone()),
+            Arg::NamedExplicit(n, e) => OwnedArg::NamedExplicit((*n).clone(), (*e).clone()),
+            Arg::Piped(_) | Arg::Default(_) => return Ok(None),
+        });
+    }
+    let result_meta = cx.fresh_meta();
+    let result = cx.eval(&result_meta)?;
+    let placeholder = cx.fresh_meta();
+    push(
+        cx,
+        Kind::Dot {
+            recv: recv.clone(),
+            field: field.clone(),
+            args: owned,
+            rterm,
+            rty,
+            blocker,
+            result: result.clone(),
+        },
+        placeholder.clone(),
+        error,
+    );
+    Ok(Some((placeholder, result)))
+}
+
+fn meta_headed(cx: &Ctx, v: &Value) -> Result<bool> {
+    Ok(matches!(
+        force(cx.g(), v.clone())?,
+        Value::Neutral(Head::Meta(_), _)
+    ))
+}
+
+fn ready(cx: &Ctx, item: &Item) -> Result<bool> {
+    match &item.kind {
+        Kind::Record { expected, .. } => Ok(!meta_headed(cx, expected)?),
+        Kind::Dot { blocker, .. } => crate::dot::blocker_solved(cx, blocker),
+    }
+}
+
+fn fill(cx: &mut Ctx, item: &Item, checked: &Term) -> Result<()> {
+    let value = cx.eval(checked)?;
+    let placeholder = cx.eval(&item.placeholder)?;
+    if !cx.unify(&value, &placeholder)? {
+        return Err(cx.mismatch(&placeholder, &value));
+    }
+    Ok(())
+}
+
+fn resume(cx: &mut Ctx, item: &Item) -> Result<()> {
+    match &item.kind {
+        Kind::Record { fields, expected } => {
+            let checked = crate::records::check_record(cx, None, fields, expected)?;
+            fill(cx, item, &checked)
+        }
+        Kind::Dot {
+            recv,
+            field,
+            args,
+            rterm,
+            rty,
+            result,
+            ..
+        } => {
+            let args: Vec<Arg> = args
+                .iter()
+                .map(|a| match a {
+                    OwnedArg::Explicit(e) => Arg::Explicit(e),
+                    OwnedArg::Named(n, e) => Arg::Named(n, e),
+                    OwnedArg::NamedExplicit(n, e) => Arg::NamedExplicit(n, e),
+                })
+                .collect();
+            let (checked, ty) =
+                crate::dot::resume_dot(cx, recv, field, &args, rterm.clone(), rty.clone())?;
+            if !cx.unify(&ty, result)? {
+                return Err(cx.mismatch(result, &ty));
+            }
+            fill(cx, item, &checked)
+        }
+    }
+}
+
+impl Elaborator {
+    /// EXPERIMENTAL: items queued, resumed, defaulted and reported stuck so
+    /// far (attempts undone included).
+    pub fn queue_stats(&self) -> [usize; 4] {
+        let q = &self.queue;
+        [q.queued.get(), q.resumed.get(), q.defaulted.get(), q.stuck.get()]
+    }
+
+    /// Resumes every queued item whose unknown is now solved, in creation
+    /// order, until none is: whether any was.
+    pub(crate) fn drain_queue(&self) -> Result<bool> {
+        self.drain_queue_from(0)
+    }
+
+    /// [`Elaborator::drain_queue`] for the items from index `from` on.
+    pub(crate) fn drain_queue_from(&self, from: usize) -> Result<bool> {
+        if !on() {
+            return Ok(false);
+        }
+        let mut any = false;
+        loop {
+            let mut progress = false;
+            let mut i = from;
+            while i < self.queue.items.borrow().len() {
+                if self.queue.done.borrow().contains(&i) {
+                    i += 1;
+                    continue;
+                }
+                let item = self.queue.items.borrow()[i].clone();
+                let mut cx = item.saved.ctx(self);
+                if ready(&cx, &item)? {
+                    self.queue.done.borrow_mut().push(i);
+                    self.queue.resumed.set(self.queue.resumed.get() + 1);
+                    let r = resume(&mut cx, &item);
+                    if std::env::var("STITCHWORT_QUEUE_TRACE").is_ok() {
+                        eprintln!("queue: resume #{i} at {:?}: {}", item.saved.span, match &r { Ok(()) => "ok".to_string(), Err(e) => format!("{} {}", e.code, e.message) });
+                    }
+                    r?;
+                    progress = true;
+                }
+                i += 1;
+            }
+            if !progress {
+                return Ok(any);
+            }
+            any = true;
+        }
+    }
+
+    /// The first record literal still waiting, given the type its field
+    /// names say (SW-805's rule, as a default): whether there was one.
+    pub(crate) fn default_queue(&self) -> Result<bool> {
+        if !on() {
+            return Ok(false);
+        }
+        let n = self.queue.items.borrow().len();
+        for i in 0..n {
+            if self.queue.done.borrow().contains(&i) {
+                continue;
+            }
+            let item = self.queue.items.borrow()[i].clone();
+            let Kind::Record { fields, expected } = &item.kind else {
+                continue;
+            };
+            let mut cx = item.saved.ctx(self);
+            self.queue.done.borrow_mut().push(i);
+            self.queue.defaulted.set(self.queue.defaulted.get() + 1);
+            let (checked, ty) = match crate::records::infer_literal_by_names(&mut cx, fields) {
+                Ok(found) => found,
+                Err(e) if crate::undo::fatal(&e) => return Err(e),
+                // Nothing says which type: the site's own error.
+                Err(_) => return Err(item.error.clone()),
+            };
+            if !cx.unify(&ty, expected)? {
+                return Err(cx.mismatch(expected, &ty));
+            }
+            fill(&mut cx, &item, &checked)?;
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    /// The error of the first item still waiting, if any.
+    pub(crate) fn stuck_queue(&self) -> Option<Diagnostic> {
+        if !on() {
+            return None;
+        }
+        let items = self.queue.items.borrow();
+        let done = self.queue.done.borrow();
+        let first = (0..items.len()).find(|i| !done.contains(i))?;
+        self.queue.stuck.set(self.queue.stuck.get() + 1);
+        Some(items[first].error.clone())
+    }
+}
