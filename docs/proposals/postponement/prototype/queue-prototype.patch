new file mode 100644
index 00000000..78f3a8e0
--- /dev/null
+++ b/dev/queue-prototype/compare.py
@@ -0,0 +1,85 @@
+"""Scratch: compare two queue_scratch outputs (off, on)."""
+import sys
+from collections import defaultdict
+
+
+def load(path):
+    res = defaultdict(list)
+    hashes = {}
+    times = {}
+    for line in open(path):
+        line = line.rstrip("\n")
+        if line.startswith("R "):
+            _, unit, rest = line.split(" ", 2)
+            res[unit].append(rest)
+        elif line.startswith("H "):
+            parts = line.split(" ")
+            unit = parts[1]
+            name = " ".join(parts[2:-1])
+            hashes[(unit, name)] = parts[-1]
+        elif line.startswith("T "):
+            _, unit, t = line.split(" ")
+            times[unit] = float(t)
+    return res, hashes, times
+
+
+off_r, off_h, off_t = load(sys.argv[1])
+on_r, on_h, on_t = load(sys.argv[2])
+
+print("== times (s): off / on")
+for k in off_t:
+    print(f"  {k:20} {off_t[k]:7.2f} {on_t.get(k, 0):7.2f}")
+
+acc_change = []
+err_change = []
+for unit in sorted(set(off_r) | set(on_r)):
+    a, b = off_r.get(unit, []), on_r.get(unit, [])
+    a_ok = a == ["OK"]
+    b_ok = b == ["OK"]
+    if a_ok != b_ok:
+        acc_change.append((unit, a, b))
+    elif not a_ok and a != b:
+        err_change.append((unit, a, b))
+
+print(f"\n== acceptance changes: {len(acc_change)}")
+for unit, a, b in acc_change:
+    print(f"  {unit}: {'accepted' if a == ['OK'] else 'rejected'} -> {'accepted' if b == ['OK'] else 'rejected'}")
+    for x in (b if a == ["OK"] else a)[:3]:
+        print(f"      {x[:300]}")
+
+code_changes = [(u, a, b) for u, a, b in err_change if [x.split(' |')[0] for x in a] != [x.split(' |')[0] for x in b]]
+print(f"\n== still rejected, error changed: {len(err_change)} (code changed in {len(code_changes)})")
+for unit, a, b in err_change:
+    print(f"  {unit}")
+    print(f"     off: {a[0][:260]}")
+    print(f"     on:  {b[0][:260]}")
+
+changed = defaultdict(list)
+only_off = defaultdict(list)
+only_on = defaultdict(list)
+for k, v in off_h.items():
+    if k in on_h:
+        if on_h[k] != v:
+            changed[k[0].split('/')[0] if '/' in k[0] else k[0]].append(k)
+    else:
+        only_off[k[0]].append(k[1])
+for k in on_h:
+    if k not in off_h:
+        only_on[k[0]].append(k[1])
+print("\n== hash changes (declarations present in both):")
+for group, ks in sorted(changed.items()):
+    units = sorted(set(u for u, _ in ks))
+    print(f"  {group}: {len(ks)} declarations in {len(units)} units")
+total = sum(len(v) for v in changed.values())
+print(f"  total {total}")
+print(f"  declarations only with off: {sum(len(v) for v in only_off.values())}, only with on: {sum(len(v) for v in only_on.values())}")
+with open(sys.argv[3], "w") as f:
+    for group, ks in sorted(changed.items()):
+        for u, n in sorted(ks):
+            f.write(f"{u}\t{n}\n")
+    for u, ns in sorted(only_off.items()):
+        for n in ns:
+            f.write(f"ONLY-OFF {u}\t{n}\n")
+    for u, ns in sorted(only_on.items()):
+        for n in ns:
+            f.write(f"ONLY-ON {u}\t{n}\n")
