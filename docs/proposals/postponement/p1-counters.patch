@@ -0,0 +1,107 @@
+//! SCRATCH: P1 measurement for docs/proposals/postponement.md. Dropped.
+
+use std::collections::BTreeMap;
+use std::path::Path;
+
+use stitchwort_driver::driver::Session;
+use stitchwort_driver::project::{DiskFiles, Target};
+
+type Counts = BTreeMap<String, usize>;
+
+fn add(total: &mut Counts, files: &mut Counts, c: &Counts) {
+    for (k, v) in c {
+        *total.entry(k.clone()).or_insert(0) += v;
+        *files.entry(k.clone()).or_insert(0) += 1;
+    }
+}
+
+fn report(name: &str, n: usize, total: &Counts, files: &Counts, out: &mut String) {
+    out.push_str(&format!("== {name}: {n} units\n"));
+    for (k, v) in total {
+        out.push_str(&format!("  {k:28} {v:7} in {:4} units\n", files[k]));
+    }
+}
+
+fn run() {
+    let mut out = String::new();
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../");
+    stitchwort_elab::p1::take();
+    let mut session = Session::eager_for_stack(512 * 1024 * 1024);
+    let std_counts = stitchwort_elab::p1::take();
+    report("std (eager library load)", 1, &std_counts, &std_counts.keys().map(|k| (k.clone(), 1)).collect(), &mut out);
+    let mark = session.mark();
+    for dir in ["accept", "reject", "extract"] {
+        let mut found: Vec<_> = std::fs::read_dir(root.join("examples").join(dir))
+            .unwrap()
+            .map(|e| e.unwrap().path())
+            .filter(|p| p.extension().is_some_and(|e| e == "sw"))
+            .collect();
+        found.sort();
+        let (mut total, mut files) = (Counts::new(), Counts::new());
+        let (mut ok, mut failed, mut cannot_infer) = (0, 0, 0);
+        let mut ci_files = Vec::new();
+        for path in &found {
+            session.rewind(&mark);
+            let text = std::fs::read_to_string(path).unwrap();
+            let r = session.load(&path.display().to_string(), &text);
+            let c = stitchwort_elab::p1::take();
+            add(&mut total, &mut files, &c);
+            match r {
+                Ok(_) => ok += 1,
+                Err(ds) => {
+                    failed += 1;
+                    if ds.iter().any(|d| d.code == "E-CANNOT-INFER") {
+                        cannot_infer += 1;
+                        ci_files.push(format!(
+                            "{} {:?}",
+                            path.file_name().unwrap().to_string_lossy(),
+                            c
+                        ));
+                    }
+                }
+            }
+        }
+        report(&format!("examples/{dir} ({ok} load, {failed} fail, {cannot_infer} fail with E-CANNOT-INFER)"), found.len(), &total, &files, &mut out);
+        if dir == "reject" {
+            for f in ci_files {
+                out.push_str(&format!("    CI {f}\n"));
+            }
+        }
+    }
+    for (label, dir, name) in [("aoc", root.join("aoc"), "aoc"), ("rogue", root.join("games/rogue"), "rogue")] {
+        session.rewind(&mark);
+        let files = DiskFiles { root: dir };
+        let r = session.load_project(&files, name, &Target::Everything);
+        let c = stitchwort_elab::p1::take();
+        let ones: Counts = c.keys().map(|k| (k.clone(), 1)).collect();
+        report(&format!("{label} (loads: {})", r.is_ok()), 1, &c, &ones, &mut out);
+    }
+    let mut dirs: Vec<_> = std::fs::read_dir(root.join("examples/projects/accept"))
+        .unwrap()
+        .map(|e| e.unwrap().path())
+        .filter(|p| p.is_dir())
+        .collect();
+    dirs.sort();
+    let (mut total, mut files) = (Counts::new(), Counts::new());
+    for dir in &dirs {
+        session.rewind(&mark);
+        let name = dir.file_name().unwrap().to_string_lossy().to_string();
+        let r = session.load_project(&DiskFiles { root: dir.clone() }, &name, &Target::Everything);
+        assert!(r.is_ok(), "{name}");
+        let c = stitchwort_elab::p1::take();
+        add(&mut total, &mut files, &c);
+    }
+    report("examples/projects/accept", dirs.len(), &total, &files, &mut out);
+    std::fs::write(std::env::var("P1_OUT").unwrap(), out).unwrap();
+}
+
+#[test]
+#[ignore]
+fn p1() {
+    std::thread::Builder::new()
+        .stack_size(1024 * 1024 * 1024)
+        .spawn(run)
+        .unwrap()
+        .join()
+        .unwrap();
+}
