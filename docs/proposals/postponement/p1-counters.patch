 //! (`stitchwort-core`), so a bug here can cause a confusing error but can't
 //! make the kernel accept something false.
 
+/// SCRATCH (P1 measurement, to be dropped).
+pub mod p1 {
+    use std::collections::BTreeMap;
+    use std::sync::Mutex;
+    static COUNTS: Mutex<BTreeMap<String, usize>> = Mutex::new(BTreeMap::new());
+    thread_local! {
+        pub static DEPTH: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+    }
+    pub fn hit(tag: &'static str) {
+        let spec = DEPTH.with(|d| d.get()) > 0;
+        let mut c = COUNTS.lock().unwrap();
+        *c.entry(tag.to_string()).or_insert(0) += 1;
+        if spec {
+            *c.entry(format!("{tag} @in-snapshot")).or_insert(0) += 1;
+        }
+    }
+    pub fn take() -> BTreeMap<String, usize> {
+        std::mem::take(&mut *COUNTS.lock().unwrap())
+    }
+}
 mod attributes;
 mod auto;
 mod autobind;
