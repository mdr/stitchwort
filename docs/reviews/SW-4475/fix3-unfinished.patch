+/// Whether, in the calls `a` and `b` of one definition, an unknown stands for
+/// a whole argument against one that is a constructor once forced (`?doc`
+/// against `Doc.group x`, which is `Group x _`).
+fn unknown_against_constructor(g: &Unifier<'_>, a: &Value, b: &Value) -> Result<bool> {
+    let (Value::Call(_, s1, _), Value::Call(_, s2, _)) = (a, b) else {
+        return Ok(false);
+    };
+    for (x, y) in s1.iter().zip(s2.iter()) {
+        let (Elim::App(x, _), Elim::App(y, _)) = (x, y) else {
+            continue;
+        };
+        for (unknown, known) in [(x, y), (y, x)] {
+            if matches!(
+                force_solved(g, unknown.clone())?,
+                Value::Neutral(Head::Meta(m), _) if !frozen(g, m)
+            ) && matches!(force(g, known.clone())?, Value::Ctor(..))
+            {
+                return Ok(true);
+            }
+        }
+    }
+    Ok(false)
+}
