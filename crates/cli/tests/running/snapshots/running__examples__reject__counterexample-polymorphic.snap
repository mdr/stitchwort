   ╭─[ reject/counterexample-polymorphic.sw:4:80 ]
   │
 4 │ theorem appendComm [a: Type] (xs: List a) (ys: List a): xs ++ ys = ys ++ xs := rfl
   │                                                                                ─┬─  
   │                                                                                 ╰─── `xs ++ ys` and `ys ++ xs` aren't equal
