  const out = [];
  while (v.tag === "Cons") {
    out.push(enc(v.head));
    v = v.tail;
  }
  return out;
};

const $add = (v0) => (v1) => {
  if (v0 === 0n) {
    return v1;
  } else {
    const v2 = v0 - 1n;
    return ($add(v2)(v1) + 1n);
