 16 │   ?
    │   ┬  
    │   ╰── xs: List Nat
    │       items: List Item
    │       id: Nat
    │       n: Nat
    │       matching: Nat := Std.List.count xs (== id)
    │       flipped: Nat := Std.List.count xs (id ==)
    │       others: Nat := Std.List.count xs (!= id)
    │       next: List Nat := Std.List.map xs (+ 1)
    │       doubled: List Nat := Std.List.map xs (n * 2 +)
    │       small: List Nat := Std.List.filter xs (< n)
    │       large: List Nat := Std.List.filter xs (n <)
    │       total: Nat := Std.List.foldLeft xs 0 (+)
    │       found: List Item := Std.List.filter items (x => Std.Decidable.toBool (Std.Nat.decEq x.id id))
    │       ⊢ Nat
