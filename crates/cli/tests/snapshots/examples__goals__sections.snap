    │       matching: Nat := List.count xs (== id)
    │       flipped: Nat := List.count xs (id ==)
    │       others: Nat := List.count xs (!= id)
    │       next: List Nat := List.map xs (+ 1)
    │       doubled: List Nat := List.map xs (n * 2 +)
    │       small: List Nat := List.filter xs (< n)
    │       large: List Nat := List.filter xs (n <)
    │       total: Nat := List.foldLeft xs 0 (+)
    │       found: List Item := List.filter items (x => Decidable.toBool (Nat.decEq x.id id))
    │       ⊢ Nat
