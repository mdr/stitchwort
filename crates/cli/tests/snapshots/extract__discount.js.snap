const dec_Bool = (x, path) => {
  if (typeof x !== "boolean") {
    throw new StitchwortInputError(`${path}: expected a boolean`);
  }
  return x ? { tag: "True" } : { tag: "False" };
};
const enc_Bool = (v) => v.tag === "True";

// Decoders read each property exactly once, into fresh values. `inside` holds
// the objects currently being decoded, so an input that contains itself is
// refused instead of recursing forever. (Shared, acyclic parts are fine.)
const enter = (x, path, inside) => {
  if (inside.has(x)) {
    throw new StitchwortInputError(`${path}: the input contains itself`);
  }
  inside.add(x);
};

const dec_List = (dec) => (x, path, inside = new Set()) => {
  if (!Array.isArray(x)) {
    throw new StitchwortInputError(`${path}: expected an array`);
  }
  enter(x, path, inside);
  const n = x.length;
  const items = new Array(n);
  for (let i = 0; i < n; i++) items[i] = dec(x[i], `${path}[${i}]`, inside);
  inside.delete(x);
  let list = { tag: "Nil" };
  for (let i = n - 1; i >= 0; i--) list = { tag: "Cons", head: items[i], tail: list };
  return list;
};
const enc_List = (enc) => (v) => {
  const out = [];
  while (v.tag === "Cons") {
    out.push(enc(v.head));
    v = v.tail;
  }
  return out;
};

const $sub = (m) => (n) => (m >= n ? m - n : 0n);
const $mul = (m) => (n) => m * n;
const $leq = (m) => (n) => ({ tag: m <= n ? "True" : "False" });
const $decTrue = (v0) => {
  switch (v0.tag) {
    case "False": {
      return { tag: "No" };
    }
    case "True": {
      return { tag: "Yes" };
    }
  }
  throw new Error("unreachable");
};
const $decEqNat = (m) => (n) => ({ tag: m === n ? "Yes" : "No" });
const $decNot = (v1) => {
  switch (v1.tag) {
    case "Yes": {
      return { tag: "No" };
    }
    case "No": {
      return { tag: "Yes" };
    }
  }
  throw new Error("unreachable");
};
const $decLessEq = (v0) => (v1) => $decTrue($leq(v0)(v1));
const $divFuel = (fuel) => (n) => (d) => { if (d === 0n) return fuel; const q = n / d; return q < fuel ? q : fuel; };
const $div = (v0) => (v1) => $divFuel(v0)(v0)(v1);
const $applyDiscount = (v0) => (v1) => $sub(v0)($div($mul(v0)(v1))(100n));
const $perPerson = (v0) => (v1) => $div(v0)(v1);

export function applyDiscount(price, percent) {
  const v0 = dec_Nat(price, "price");
  const v1 = dec_Nat(percent, "percent");
  if ($decLessEq(v1)(100n).tag !== "Yes") {
    throw new StitchwortInputError("precondition `percent <= 100` doesn't hold");
  }
  return enc_Nat($applyDiscount(v0)(v1));
}

export function perPerson(total, people) {
  const v0 = dec_Nat(total, "total");
  const v1 = dec_Nat(people, "people");
  if ($decNot($decEqNat(v1)(0n)).tag !== "Yes") {
    throw new StitchwortInputError("precondition `people != 0` doesn't hold");
  }
  return enc_Nat($perPerson(v0)(v1));
}
