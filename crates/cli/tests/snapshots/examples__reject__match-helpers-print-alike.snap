[E-REFL] Error: `rfl` can't prove this
    ╭─[ reject/match-helpers-print-alike.sw:11:58 ]
    │
  8 │ def foo (xs: List (Option Nat)): Nat := xs.foldLeft 0 (acc o => match o with | Some x => acc + x | None => acc)
    │                                                                 ───────────────────────┬──────────────────────  
    │                                                                                        ╰──────────────────────── this `match`
  9 │ def bar (xs: List (Option Nat)): Nat := xs.foldLeft 0 (acc o => match o with | Some x => acc + x | None => acc + 1)
    │                                                                 ─────────────────────────┬────────────────────────  
    │                                                                                          ╰────────────────────────── this `match`
