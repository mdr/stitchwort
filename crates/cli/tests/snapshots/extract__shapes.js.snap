const dec_Nat = (x, path) => {
  if (typeof x !== "bigint" || x < 0n) {
    throw new StitchwortInputError(`${path}: expected a non-negative bigint`);
  }
  return x;
};
const enc_Nat = (v) => v;

const dec_Bool = (x, path) => {
  if (typeof x !== "boolean") {
    throw new StitchwortInputError(`${path}: expected a boolean`);
  }
  return x ? { tag: "True" } : { tag: "False" };
};
const enc_Bool = (v) => v.tag === "True";

// Decoders read each property exactly once, into fresh values. `inside` holds
// the objects currently being decoded, so an input that contains itself is
// refused instead of recursing forever. (Shared, acyclic parts are fine.)
const enter = (x, path, inside) => {
  if (inside.has(x)) {
    throw new StitchwortInputError(`${path}: the input contains itself`);
  }
  inside.add(x);
};

const dec_List = (dec) => (x, path, inside = new Set()) => {
  if (!Array.isArray(x)) {
    throw new StitchwortInputError(`${path}: expected an array`);
  }
  enter(x, path, inside);
  const n = x.length;
  const items = new Array(n);
  for (let i = 0; i < n; i++) items[i] = dec(x[i], `${path}[${i}]`, inside);
  inside.delete(x);
  let list = { tag: "Nil" };
  for (let i = n - 1; i >= 0; i--) list = { tag: "Cons", head: items[i], tail: list };
  return list;
};
const enc_List = (enc) => (v) => {
  const out = [];
  while (v.tag === "Cons") {
    out.push(enc(v.head));
    v = v.tail;
  }
  return out;
};

function dec_Shape(x, path, inside = new Set()) {
  if (typeof x !== "object" || x === null) {
    throw new StitchwortInputError(`${path}: expected a Shape object`);
  }
  enter(x, path, inside);
  const tag = x.tag;
  switch (tag) {
    case "Square": {
      const side = dec_Nat(x.side, `${path}.side`, inside);
      inside.delete(x);
      return { tag: "Square", side };
    }
    case "Rect": {
      const width = dec_Nat(x.width, `${path}.width`, inside);
      const height = dec_Nat(x.height, `${path}.height`, inside);
      inside.delete(x);
      return { tag: "Rect", width, height };
    }
    default:
      throw new StitchwortInputError(`${path}: unknown tag ${String(tag)}`);
  }
}
function enc_Shape(v) {
  switch (v.tag) {
    case "Square": return { tag: "Square", side: enc_Nat(v.side) };
    case "Rect": return { tag: "Rect", width: enc_Nat(v.width), height: enc_Nat(v.height) };
  }
  throw new Error("unreachable");
}

const $add = (v0) => (v1) => {
  if (v0 === 0n) {
    return v1;
  } else {
    const v2 = v0 - 1n;
    return ($add(v2)(v1) + 1n);
  }
};
const $mul = (v0) => (v1) => {
  if (v0 === 0n) {
    return 0n;
  } else {
    const v2 = v0 - 1n;
    return $add(v1)($mul(v2)(v1));
  }
};
const $area = (v0) => {
  switch (v0.tag) {
    case "Square": {
      const v1 = v0.side;
      return $mul(v1)(v1);
    }
    case "Rect": {
      const v1 = v0.width;
      const v2 = v0.height;
      return $mul(v1)(v2);
    }
  }
  throw new Error("unreachable");
};
const $areas = (v0) => {
  switch (v0.tag) {
    case "Nil": {
      return { tag: "Nil" };
    }
    case "Cons": {
      const v1 = v0.head;
      const v2 = v0.tail;
      return { tag: "Cons", head: $area(v1), tail: $areas(v2) };
    }
  }
  throw new Error("unreachable");
};
const $grow = (v0) => {
  switch (v0.tag) {
    case "Square": {
      const v1 = v0.side;
      return { tag: "Square", side: (v1 + 1n) };
    }
    case "Rect": {
      const v1 = v0.width;
      const v2 = v0.height;
      return { tag: "Rect", width: (v1 + 1n), height: (v2 + 1n) };
    }
  }
  throw new Error("unreachable");
