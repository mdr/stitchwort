export function area(arg0) {
  const v0 = dec_Shape(arg0, "arg0");
  return enc_Nat($area(v0));
}

export function areas(arg0) {
  const v0 = dec_List(dec_Shape)(arg0, "arg0");
  return enc_List(enc_Nat)($areas(v0));
}

export function grow(arg0) {
  const v0 = dec_Shape(arg0, "arg0");
  return enc_Shape($grow(v0));
