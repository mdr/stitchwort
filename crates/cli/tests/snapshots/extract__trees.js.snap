  const out = [];
  while (v.tag === "Cons") {
    out.push(enc(v.head));
    v = v.tail;
  }
  return out;
};

function dec_Tree(x, path) {
  if (typeof x !== "object" || x === null) {
    throw new StitchwortInputError(`${path}: expected a Tree object`);
  }
  const tag = x.tag;
  switch (tag) {
    case "Leaf": {
      return { tag: "Leaf" };
    }
    case "Node": {
      const left = dec_Tree(x.left, `${path}.left`);
      const right = dec_Tree(x.right, `${path}.right`);
      return { tag: "Node", left, right };
    }
    default:
      throw new StitchwortInputError(`${path}: unknown tag ${String(tag)}`);
