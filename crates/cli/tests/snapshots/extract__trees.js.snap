// Decoding reads `length` and each element exactly once, into a fresh list.
const dec_List = (dec) => (x, path) => {
  if (!Array.isArray(x)) {
    throw new StitchwortInputError(`${path}: expected an array`);
  }
  const n = x.length;
  const items = new Array(n);
