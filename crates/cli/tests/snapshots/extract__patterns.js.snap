    case "Cons": {
      const v1 = v0.head;
      const v2 = v0.tail;
      switch (v2.tag) {
        case "Nil": {
          return { tag: "False" };
        }
        case "Cons": {
          const v3 = v2.head;
          const v4 = v2.tail;
          switch (v4.tag) {
            case "Nil": {
              return { tag: "True" };
            }
            case "Cons": {
              const v5 = v4.head;
              const v6 = v4.tail;
              return { tag: "False" };
            }
          }
          throw new Error("unreachable");
        }
      }
      throw new Error("unreachable");
    }
  }
  throw new Error("unreachable");
};
const $describe = (v0) => {
  if (v0 === 0n) {
    return v0;
  } else {
    const v1 = v0 - 1n;
    if (v1 === 0n) {
      return v0;
    } else {
      const v2 = v1 - 1n;
      if (v2 === 0n) {
        return v0;
      } else {
        const v3 = v2 - 1n;
        if (v3 === 0n) {
          return 30n;
        } else {
          const v4 = v3 - 1n;
          if (v4 === 0n) {
            return v0;
          } else {
            const v5 = v4 - 1n;
            if (v5 === 0n) {
              return v0;
            } else {
              const v6 = v5 - 1n;
              if (v6 === 0n) {
                return v0;
              } else {
                const v7 = v6 - 1n;
                if (v7 === 0n) {
                  return 70n;
                } else {
                  const v8 = v7 - 1n;
                  return v0;
                }
              }
            }
          }
        }
      }
    }
  }
};
const $sameLength = (v0) => (v1) => $toBool($decEqNat($length(v0))($length(v1)));
const $bigEqual = (v0) => $toBool($decEqNat($mul(v0)(2n))($add(v0)(v0)));

function $$half(arg0) {
  try {
    const v0 = decode(NAT, arg0, "arg0");
    return encode(NAT, $half(v0));
  } catch (e) {
    throw outOfResources("half", e);
  }
}

function $$fib(arg0) {
  try {
    const v0 = decode(NAT, arg0, "arg0");
    return encode(NAT, $fib(v0));
  } catch (e) {
    throw outOfResources("fib", e);
  }
}

function $$hasTwo(arg0) {
  try {
    const v0 = decode(list(NAT), arg0, "arg0");
    return encode(BOOL, $hasTwo(v0));
  } catch (e) {
    throw outOfResources("hasTwo", e);
  }
}

function $$describe(arg0) {
  try {
    const v0 = decode(NAT, arg0, "arg0");
    return encode(NAT, $describe(v0));
  } catch (e) {
