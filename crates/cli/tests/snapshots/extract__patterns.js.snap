function $$bigEqual(arg0) {
  try {
    const v0 = decode(NAT, arg0, "n");
    return encode(BOOL, $bigEqual(v0));
  } catch (e) {
    throw outOfResources("bigEqual", e);
  }
}

export { $$half as half, $$fib as fib, $$hasTwo as hasTwo, $$describe as describe, $$sameLength as sameLength, $$bigEqual as bigEqual };
