}

function $$sameLength(arg0, arg1) {
  try {
    const v0 = decode(list(NAT), arg0, "xs");
    const v1 = decode(list(NAT), arg1, "ys");
    return encode(BOOL, $sameLength(v0)(v1));
  } catch (e) {
    throw outOfResources("sameLength", e);
