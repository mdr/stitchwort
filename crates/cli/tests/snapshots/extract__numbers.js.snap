  const codes = scalars(x, path);
  let chars = { tag: "Nil" };
  for (let i = codes.length - 1; i >= 0; i--) {
    chars = { tag: "Cons", head: { tag: "MkChar", code: codes[i] }, tail: chars };
  }
  return { tag: "MkText", chars };
};
