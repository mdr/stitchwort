fn Main.main(v0) {3 slots} =
  let v1 = %TextSplit(MkChar(44), "12,-5,x")
  Std.Effect.bind({
    let v2 = %TextJoin(MkChar(32), Std.List.map(λ3(v0) {1 slots} =>
      %IntToText(Main.signed(v0)), v1))
