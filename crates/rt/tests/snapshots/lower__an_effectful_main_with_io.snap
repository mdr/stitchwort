---
source: crates/rt/tests/lower.rs
expression: "ir(r#\"\nimport Std (Nat, Text, Int)\ndef greet (name: Text): {IO} () := IO.print (\"hello \" ++ name)\n\ndef main(): {IO} () :=\n  match IO.readLine() with\n    | Some name => greet name\n    | None => IO.print \"nobody\"\n\"#)"
---
native Std.Text.append = %TextAppend/2
fn Std.Effect.bind(v0, v1) {4 slots} =
  match v0: Effect.Comp {
    Done(value: v2) => apply v1(v2)
    Call(o: v2, rest: v3) =>
      Call(v2, λ0[c0 = v3, c1 = v1](v0) {1 slots} =>
        Std.Effect.bind(apply c0(v0), c1))
  }
native Std.Effect.lift = %Effect.lift/1
fn Main.greet(v0) {2 slots} =
  let v1 = %TextAppend("hello ", v0)
  Call(L(%print(v1)), done-k)
fn Main.main(v0) {1 slots} =
  Std.Effect.bind(Call(L(%readLine(UnitValue)), done-k), λ1(v0) {1 slots} =>
    Main.main.%match1(v0))
fn Main.main.%match1(v0) {2 slots} =
  match v0: Option {
    None => Call(L(%print("nobody")), done-k)
    Some(value: v1) => Main.greet(v1)
  }
entry {1 slots} = %Effect.lift(Main.main(UnitValue))
