  %EffectBind(Call(L(%readLine(UnitValue)), done-k), λ0(v0) {3 slots} =>
    match v0: Option {
      None => Call(L(%print("nobody")), done-k)
      Some(value: v1) =>
        let v2 = %TextAppend("hello ", v1)
        Call(L(%print(v2)), done-k)
    })
