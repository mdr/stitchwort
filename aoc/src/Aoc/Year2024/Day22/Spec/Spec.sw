-- Day 22 as the puzzle states it, over the program's `Changes`. The proofs
-- (Proofs/) show the program's step is the puzzle's for every secret, and
-- both parts are the puzzle's answers for every list of buyers.

namespace Aoc.Year2024.Day22.Spec
import Aoc.Year2024.Day22 (Changes)
import Std (Bool, Int, List, Nat, Option)

-- Whether bit `i` of `n` is 1: the bit worth 2 to the power `i`.
def bitSet (n: Nat) (i: Nat): Bool := n / Nat.pow 2 i % 2 == 1

-- "The bitwise XOR of" `x` and `y` is `result`: each bit of it is 1 when
-- exactly one of `x` and `y` has that bit 1.
def BitwiseXor (x: Nat) (y: Nat) (result: Nat): Prop := (i: Nat) → bitSet result i = Bool.xor (bitSet x i) (bitSet y i)

-- "To mix a value into the secret number, calculate the bitwise XOR of the
-- given value and the secret number. Then, the secret number becomes the
-- result of that operation." `Nat.xor value secret` is that XOR, and the
-- only number that is (`mixBitwise` and `bitwiseXorUnique` in Proofs/).
def mix (value: Nat) (secret: Nat): Nat := Nat.xor value secret

-- "To prune the secret number, calculate the value of the secret number
-- modulo 16777216."
def prune (secret: Nat): Nat := secret % 16777216

-- "each buyer's secret number evolves into the next secret number in the
-- sequence via the following process":
def evolve (secret: Nat): Nat :=
  -- "Calculate the result of multiplying the secret number by 64. Then, mix
  -- this result into the secret number. Finally, prune the secret number."
  let first := prune (mix (secret * 64) secret)
  -- "Calculate the result of dividing the secret number by 32. Round the
  -- result down to the nearest integer. Then, mix this result into the
  -- secret number. Finally, prune the secret number."
  let second := prune (mix (first / 32) first)
  -- "Calculate the result of multiplying the secret number by 2048. Then,
  -- mix this result into the secret number. Finally, prune the secret
  -- number."
  prune (mix (second * 2048) second)

-- "For each buyer, simulate the creation of 2000 new secret numbers. What
-- is the sum of the 2000th secret number generated by each buyer?"
def part1 (buyers: List Nat): Nat := buyers.sumBy (buyer => Nat.iterate 2000 evolve buyer)

-- Part 2.

-- A buyer's initial secret number, then the `count` it generates after it
-- ("Each buyer is going to generate 2000 secret numbers after their initial
-- secret number").
def secretNumbers: (count: Nat) → (secret: Nat) → List Nat
  | Zero, secret => [secret]
  | Succ count, secret => Cons secret (secretNumbers count (evolve secret))

-- "the prices the buyer offers are just the ones digit of each of their
-- secret numbers".
def offeredPrices (count: Nat) (buyer: Nat): List Nat := secretNumbers count buyer |> .map (secret => secret % 10)

-- Where the monkey is in a buyer's prices: `later` is the price it is at
-- and those after it, following four earlier prices. It sells here when the
-- four changes in price into this one are `sequence` ("the first price has
-- no associated change").
def sellsAt (sequence: Changes) (later: List Nat): Option Nat :=
  match later with
    | Cons a (Cons b (Cons c (Cons d (Cons e rest)))) =>
      if
        ({ first = b.toInt - a.toInt, second = c.toInt - b.toInt, third = d.toInt - c.toInt, fourth = e.toInt - d.toInt }: Changes) ==
          sequence
      then Some e
      else None
    | _ => None

-- "it would wait until the first time it sees that sequence and then
-- immediately sell your hiding spot information at the current price": the
-- price at the first place, in order, where the monkey sells, if any.
def sellingPrice (sequence: Changes) (prices: List Nat): Option Nat := prices.tails.findMap (sellsAt sequence)

-- "If the monkey never hears that sequence of price changes from a buyer,
-- the monkey will never sell": nothing from that buyer.
def bananas (count: Nat) (buyers: List Nat) (sequence: Changes): Nat :=
  buyers.sumBy (buyer => sellingPrice sequence (offeredPrices count buyer) |> .getOrElse 0)

-- A change between two prices, each a digit: from -9 to 9.
def possibleChanges: List Int := List.range 19 |> .map (offset => offset.toInt - 9)

-- Every sequence of four of `changes`.
def sequencesOf (changes: List Int): List Changes :=
  changes.flatMap (first =>
    changes.flatMap (second => changes.flatMap (third => changes.map (fourth => ({ first, second, third, fourth }: Changes)))))

-- Every "sequence of four price changes" the monkey could be told.
def possibleSequences: List Changes := sequencesOf possibleChanges

-- "determine which sequence of four price changes will cause the monkey to
-- get you the most bananas overall ... What is the most bananas you can
-- get?": the most any of `sequences` earns, with each buyer's `count`
-- generated secrets. Part 2's answer is `mostBananas possibleSequences
-- 2000 buyers` ("you'll have 2000 price changes in which your sequence can
-- occur"). It has no `part2` name: the checker would compute all 130,321
-- sequences' bananas to see that the name stands for it.
def mostBananas (sequences: List Changes) (count: Nat) (buyers: List Nat): Nat := sequences.map (bananas count buyers) |> .foldLeft 0 Nat.max
