#!/usr/bin/env bash
# Pre-commit hook (flake.nix, `git-hooks`): fails if a staged `.sw` file isn't
# formatted, listing it. Takes the staged file names as arguments, from prek.
#
# Checks what `the_repository_sources_are_formatted`
# (crates/cli/tests/tools/fmt.rs) checks, so a commit this lets through can't
# turn that test red: every `.sw` file, bar the paths the repository keeps as
# written (`DELIBERATELY_UNFORMATTED` in crates/fmt/src/lib.rs), which
# `stitchwort fmt --check` skips by itself when they are named.
#
# Runs the release CLI of this worktree (or clone) if it has one, else of the
# main checkout (a worktree's common git dir is its .git), else of any folder
# above this one (a scratch clone lives under the main checkout's
# .claude/worktrees/); with none, warns and lets the commit through (the hook
# is `verbose` in flake.nix, or prek would hide that warning, as it hides all
# output of a passing hook). A lane changing the syntax or the formatter should
# build its own release binary first (`task build`), or this uses the main
# checkout's older one and judges the lane's files by it.
set -eu

root=$(git rev-parse --show-toplevel)
common=$(git rev-parse --path-format=absolute --git-common-dir)
bin=
if [ -x "$root/target/release/stitchwort" ]; then
  bin="$root/target/release/stitchwort"
fi
dir=$root
for next in "$(dirname "$common")" "$root"; do
  dir=$next
  while [ -n "$dir" ] && [ -z "$bin" ]; do
    [ -x "$dir/target/release/stitchwort" ] && bin="$dir/target/release/stitchwort"
    [ "$dir" = / ] && break
    dir=$(dirname "$dir")
  done
done
if [ -z "$bin" ]; then
  echo "stitchwort-fmt: no target/release/stitchwort in this checkout, the main one or a folder above; skipping the .sw format check" >&2
  exit 0
fi

files=()
for file in "$@"; do
  [ -f "$root/$file" ] && files+=("$root/$file")
done
[ ${#files[@]} -gt 0 ] || exit 0

# --check lists the files that would change on stdout.
status=0
listed=$("$bin" fmt --check "${files[@]}") || status=$?
if [ $status -gt 1 ]; then
  echo "stitchwort-fmt: \`stitchwort fmt --check\` failed (a file that doesn't parse?)" >&2
  exit 1
fi
if [ -n "$listed" ]; then
  echo "stitchwort-fmt: not formatted (run \`stitchwort fmt\` on them):" >&2
  echo "${listed//$root\//}" >&2
  exit 1
fi
