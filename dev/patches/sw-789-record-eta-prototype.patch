+/// PROTOTYPE (SW-789): gives record `d` eta, with `projections` as its
+/// fields' projections, when it's eligible: a record with one constructor,
+/// no parameters or indices, not in `Prop`, alone in its group, with a field
+/// that isn't a proof. Returns whether it did. (Doesn't check that no field
+/// mentions the type, nor that the projections are the projections.)
+pub fn prototype_set_eta(g: &mut Kernel, d: DataId, projections: Vec<crate::DefId>) -> bool {
+    if std::env::var_os("SW_NO_ETA").is_some() {
+        return false;
+    }
+    let Some(data) = g.env.datas().get(d.0) else {
+        return false;
+    };
+    let eligible = data.record
+        && data.state == State::Final
+        && data.ctors.len() == 1
+        && data.params.is_empty()
+        && data.indices.is_empty()
+        && data.sort != Sort::Prop
+        && data.group.len() == 1
+        && projections.len() == data.ctors[0].fields.len()
+        && data.ctors[0].field_sorts.iter().any(|s| *s != Sort::Prop);
+    if eligible {
+        g.env.datas_mut()[d.0].eta_projections = Some(projections.into());
+    }
+    eligible
+}
