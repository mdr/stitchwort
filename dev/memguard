#!/usr/bin/env python3
"""Run a command and kill its whole process tree if it uses too much memory.

Usage: dev/memguard [--cap-gb GB] [--report] -- COMMAND [ARG...]

Every test task in Taskfile.yml runs under this (docs/testing.md, "Memory").
About twice a second it sums the memory of COMMAND and every process
descended from it, but for the compiler and linker (rustc and the like, when
cargo builds before testing; see BUILD_TOOLS). When the sum passes the cap it prints the cap, the total
and the five biggest processes with their command lines (a nextest child's
names its test), sends SIGTERM to the tree, then SIGKILL two seconds later,
and exits 137.

The cap is --cap-gb (the tier's default), unless STITCHWORT_MEM_CAP_GB is
set, which wins; 0 means no cap. --report (or STITCHWORT_MEM_REPORT=1)
prints the peak and the biggest processes at the peak when COMMAND ends, for
measuring a tier.

The memory of a process is its physical footprint on macOS (what Activity
Monitor and `top` show as MEM: resident plus compressed, which RSS leaves
out under memory pressure), and its RSS elsewhere (from /proc on Linux, else
`ps`). Python 3's standard library only: no dependencies.
"""

import ctypes
import ctypes.util
import os
import signal
import subprocess
import sys
import time

POLL_SECONDS = 0.5
GRACE_SECONDS = 2.0
GB = 1024**3


# ------------------------------------------------------------ the process table


def _proc_table():
    """{pid: (ppid, rss_bytes, command)} for every process, from /proc."""
    table = {}
    page = os.sysconf("SC_PAGE_SIZE")
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            with open(f"/proc/{pid}/stat", "rb") as f:
                stat = f.read().decode("utf-8", "replace")
            # The command name is in parentheses and may hold spaces.
            fields = stat[stat.rindex(")") + 2 :].split()
            ppid = int(fields[1])
            rss = int(fields[21]) * page
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                command = f.read().replace(b"\0", b" ").decode("utf-8", "replace").strip()
        except (OSError, ValueError, IndexError):
            continue
        table[pid] = (ppid, rss, command)
    return table


def _ps_table():
    """{pid: (ppid, rss_bytes, command)} for every process, from `ps`."""
    out = subprocess.run(
        ["ps", "-axo", "pid=,ppid=,rss=,command="],
        capture_output=True,
        text=True,
        errors="replace",
    ).stdout
    table = {}
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 3:
            continue
        try:
            pid, ppid, rss_kb = int(parts[0]), int(parts[1]), int(parts[2])
        except ValueError:
            continue
        # macOS's ps writes a newline in an argument as `\012`.
        command = parts[3].replace("\\012", " ") if len(parts) > 3 else ""
        table[pid] = (ppid, rss_kb * 1024, command)
    return table


class _RusageInfoV0(ctypes.Structure):
    _fields_ = [
        ("ri_uuid", ctypes.c_uint8 * 16),
        ("ri_user_time", ctypes.c_uint64),
        ("ri_system_time", ctypes.c_uint64),
        ("ri_pkg_idle_wkups", ctypes.c_uint64),
        ("ri_interrupt_wkups", ctypes.c_uint64),
        ("ri_pageins", ctypes.c_uint64),
        ("ri_wired_size", ctypes.c_uint64),
        ("ri_resident_size", ctypes.c_uint64),
        ("ri_phys_footprint", ctypes.c_uint64),
        ("ri_proc_start_abstime", ctypes.c_uint64),
        ("ri_proc_exit_abstime", ctypes.c_uint64),
    ]


def _darwin_footprint():
    """A function from a pid to its physical footprint in bytes (or None),
    through libproc's proc_pid_rusage; None if that isn't available."""
    if sys.platform != "darwin":
        return None
    try:
        libproc = ctypes.CDLL(ctypes.util.find_library("proc") or "/usr/lib/libproc.dylib")
        rusage = libproc.proc_pid_rusage
    except (OSError, AttributeError):
        return None
    rusage.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_void_p]
    rusage.restype = ctypes.c_int

    def footprint(pid):
        info = _RusageInfoV0()
        if rusage(pid, 0, ctypes.byref(info)) != 0:
            return None
        return info.ri_phys_footprint

    return footprint


if os.path.exists("/proc/self/stat"):
    process_table = _proc_table
else:
    process_table = _ps_table
footprint = _darwin_footprint()
METRIC = "physical footprint" if footprint else "RSS"


def tree(root):
    """[(pid, bytes, command)] for `root` and its descendants."""
    table = process_table()
    children = {}
    for pid, (ppid, _, _) in table.items():
        children.setdefault(ppid, []).append(pid)
    found, todo = [], [root]
    seen = set()
    while todo:
        pid = todo.pop()
        if pid in seen or pid not in table:
            continue
        seen.add(pid)
        _, rss, command = table[pid]
        size = footprint(pid) if footprint else None
        found.append((pid, rss if size is None else size, command))
        todo.extend(children.get(pid, []))
    return found


# The compiler and linker, when the command builds before it tests: their
# memory is cargo's business (CARGO_BUILD_JOBS), not the tests', so it isn't
# counted against the cap. Everything else is, the doctests (rustdoc) too.
BUILD_TOOLS = {"rustc", "clippy-driver", "cc", "c++", "clang", "clang++", "ld", "ld64", "ld.lld", "collect2"}


def is_build_tool(command):
    words = command.split(None, 1)
    return bool(words) and os.path.basename(words[0]) in BUILD_TOOLS


def counted(processes):
    """The processes counted against the cap: all but the build tools."""
    return [p for p in processes if not is_build_tool(p[2])]


# ---------------------------------------------------------------- reporting


def gb(n):
    return f"{n / GB:.2f} GB"


def biggest(processes, count=5):
    lines = []
    for pid, size, command in sorted(processes, key=lambda p: -p[1])[:count]:
        if len(command) > 300:
            command = command[:297] + "..."
        lines.append(f"  {gb(size):>9}  pid {pid:<7} {command}")
    return lines


def say(*lines):
    sys.stderr.write("".join(f"memguard: {line}\n" if i == 0 else f"{line}\n" for i, line in enumerate(lines)))
    sys.stderr.flush()


# ------------------------------------------------------------------- killing


def signal_tree(root, sig):
    """Sends `sig` to `root`'s process group and to every descendant (some
    may have left the group)."""
    try:
        os.killpg(root, sig)
    except OSError:
        pass
    for pid, _, _ in tree(root):
        try:
            os.kill(pid, sig)
        except OSError:
            pass


def kill_tree(child):
    signal_tree(child.pid, signal.SIGTERM)
    deadline = time.monotonic() + GRACE_SECONDS
    while time.monotonic() < deadline:
        if child.poll() is not None and not tree(child.pid):
            break
        time.sleep(0.1)
    # The tree's survivors, including any whose parent exited.
    signal_tree(child.pid, signal.SIGKILL)
    child.wait()


# ---------------------------------------------------------------------- main


def parse(argv):
    cap_gb, report = None, os.environ.get("STITCHWORT_MEM_REPORT", "") not in ("", "0")
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            break
        if arg == "--cap-gb":
            cap_gb = float(argv[i + 1])
            i += 2
        elif arg.startswith("--cap-gb="):
            cap_gb = float(arg.split("=", 1)[1])
            i += 1
        elif arg == "--report":
            report = True
            i += 1
        elif arg in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        else:
            break
    command = argv[i:]
    if not command:
        sys.exit("memguard: no command; usage: dev/memguard [--cap-gb GB] [--report] -- COMMAND [ARG...]")
    override = os.environ.get("STITCHWORT_MEM_CAP_GB", "")
    if override:
        cap_gb = float(override)
    if cap_gb is None:
        sys.exit("memguard: no cap: pass --cap-gb or set STITCHWORT_MEM_CAP_GB (0 for none)")
    return cap_gb, report, command


def main():
    cap_gb, report, command = parse(sys.argv[1:])
    cap = cap_gb * GB
    # Its own process group, so the whole tree can be signalled at once.
    # Ctrl-C at the terminal reaches the group too: we forward it.
    child = subprocess.Popen(command, start_new_session=True)

    def forward(sig, _frame):
        signal_tree(child.pid, sig)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, forward)

    peak, peak_processes = 0, []
    while child.poll() is None:
        processes = counted(tree(child.pid))
        total = sum(size for _, size, _ in processes)
        if total > peak:
            peak, peak_processes = total, processes
        if cap > 0 and total > cap:
            say(
                f"killed: the tests used {gb(total)} ({METRIC}), over the cap of {gb(cap)}.",
                "The five biggest processes:",
                *biggest(processes),
                "The cap is per tier (docs/testing.md, \"Memory\"); STITCHWORT_MEM_CAP_GB overrides it.",
            )
            kill_tree(child)
            sys.exit(137)
        time.sleep(POLL_SECONDS)
    # Descendants the command left running stay ours to watch no longer.
    if report:
        say(
            f"peak {gb(peak)} ({METRIC}, cap {gb(cap) if cap > 0 else 'none'}); the biggest processes at the peak:",
            *biggest(peak_processes),
        )
    code = child.returncode
    sys.exit(128 - code if code < 0 else code)


if __name__ == "__main__":
    main()
