#!/usr/bin/env python3
"""Which frames make up the deepest point of a run's native stack (SW-3227).

    task stack:peak -- COMMAND...        (builds, runs, and calls this)
    dev/stack-peak BINARY TRACE [--top N]

BINARY is a release `stitchwort` built with `STITCHWORT_STACK_PROBE=deepest`
(`stack::probe`, crates/syntax/src/stack.rs), TRACE the standard error of a run
of it: the probe ends it with `DEEPEST <bytes>` and the symbols of the backtrace
taken at the deepest point, innermost first. Each symbol's frame is read from
its prologue in BINARY (`nm` and `objdump`; arm64 only: saved registers, `sub
sp`, and the probe loop's `sub x9, sp` for a frame past a page), and the table
sums them by function: bytes along the peak, how many times the function is on
the stack, its frame, and its share of the sum. The sum is static, from the
prologues, so it differs a little from the probe's measure (which counts from
where the stack began, and sees a frame's dynamic parts, `alloca`s and the
rest); both are printed.
"""

import argparse
import collections
import re
import subprocess
import sys


def strip_hash(name):
    return re.sub(r"::h[0-9a-f]{16}$", "", re.sub(r" \(\.llvm\.\d+\)$", "", name))


def read_trace(path):
    """The probe's depth and the backtrace's symbols, from a run's stderr."""
    depth, names = None, []
    for line in open(path, errors="replace"):
        m = re.match(r"DEEPEST (\d+)$", line)
        if m:
            depth, names = int(m.group(1)), []
        elif depth is not None:
            m = re.match(r"(\d+) (.+)$", line.rstrip("\n"))
            if m and int(m.group(1)) == len(names):
                names.append(strip_hash(m.group(2)))
    if depth is None:
        sys.exit(
            f"{path}: no `DEEPEST` line: was the binary built with "
            "STITCHWORT_STACK_PROBE=deepest, and did the run finish?"
        )
    # The first frames are the backtrace's and the probe's own.
    skip = ("<std::backtrace::Backtrace>::create", "stitchwort_syntax::stack::probe::")
    return depth, [n for n in names if not n.startswith(skip)]


def symbols(binary):
    out = subprocess.run(
        ["nm", "-n", "--demangle", "--defined-only", binary],
        capture_output=True, text=True, check=True,
    ).stdout
    syms = []
    for line in out.splitlines():
        parts = line.split(" ", 2)
        if len(parts) == 3 and parts[1] in ("t", "T"):
            syms.append((int(parts[0], 16), strip_hash(parts[2])))
    return syms


def frame_bytes(binary, start, end):
    dis = subprocess.run(
        ["objdump", "-d", "--no-show-raw-insn", f"--start-address={start:#x}",
         f"--stop-address={end:#x}", binary],
        capture_output=True, text=True,
    ).stdout
    total, probing = 0, False
    for line in dis.splitlines():
        m = re.search(r"sub\s+x9, sp, #(0x[0-9a-f]+|\d+)(, lsl #12)?", line)
        if m:
            v = int(m.group(1), 0)
            total += v << 12 if m.group(2) else v
            probing = True
            continue
        if probing and re.search(r"sub\s+sp, sp, #0x1, lsl #12", line):
            continue
        m = re.search(r"stp\s+\S+, \S+, \[sp, #-(0x[0-9a-f]+|\d+)\]!", line)
        if m:
            total += int(m.group(1), 0)
        m = re.search(r"sub\s+sp, sp, #(0x[0-9a-f]+|\d+)(, lsl #12)?", line)
        if m:
            v = int(m.group(1), 0)
            total += v << 12 if m.group(2) else v
    return total


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("binary")
    ap.add_argument("trace")
    ap.add_argument("--top", type=int, default=25, help="rows to show (default 25)")
    args = ap.parse_args()

    depth, names = read_trace(args.trace)
    want = set(names)
    syms = symbols(args.binary)
    size = {}
    for i, (addr, name) in enumerate(syms):
        if name in want and name not in size:
            # A prologue is within the first few dozen instructions.
            end = min(addr + 0x60, syms[i + 1][0] if i + 1 < len(syms) else addr + 0x60)
            size[name] = frame_bytes(args.binary, addr, end)

    count = collections.Counter(names)
    rows = sorted(
        ((size.get(n, 0) * k, k, size.get(n), n) for n, k in count.items()), reverse=True
    )
    total = sum(r[0] for r in rows)
    print(f"probe: {depth} bytes below the stack's base; frames: {len(names)}; "
          f"sum of their prologues: {total} bytes")
    print(f"{'bytes':>8} {'share':>6} {'times':>5} {'frame':>7}  function")
    for bytes_, k, frame, name in rows[: args.top]:
        share = f"{100 * bytes_ / total:.1f}%" if total else "-"
        shown = "?" if frame is None else str(frame)
        print(f"{bytes_:8d} {share:>6} {k:5d} {shown:>7}  {name[:110]}")
    if len(rows) > args.top:
        rest = sum(r[0] for r in rows[args.top:])
        print(f"{rest:8d} {'':>6} {'':>5} {'':>7}  ({len(rows) - args.top} more functions)")
    missing = [n for n in count if n not in size]
    if missing:
        print(f"no symbol for {len(missing)} function(s), counted as 0 (e.g. {missing[0][:80]})")


if __name__ == "__main__":
    main()
