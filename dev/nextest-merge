#!/usr/bin/env python3
"""Generate the merge profile's default-filter in .config/nextest.toml.

nextest has no includes, so the merge tier (the lane areas together, plus a
few extras) would be a hand-made copy of the lane filters that drifts. The
copy is generated from them instead:

  dev/nextest-merge           rewrite the merge profile's default-filter
  dev/nextest-merge --check   exit 1 when the file is not what it generates
                              (the test-affected tests run this)

Change a lane's filter, then run this; change the merge-only parts (EXTRAS) or
the lanes left out (NOT_IN_MERGE) here.
"""
import os
import re
import sys
import tomllib

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
NEXTEST = os.path.join(ROOT, ".config", "nextest.toml")

# Lanes whose tests are not in the merge tier, and why.
NOT_IN_MERGE = {
    "lane-goals": "goals end to end: for the daily tier and `task test:lane`",
    "lane-web": "the web crate's tests need the WebAssembly bundle; for the daily tier",
}

# Merge-only parts: wider than any one lane's.
EXTRAS = [
    "package(stitchwort-core)",
    "package(stitchwort-native)",
    "(package(stitchwort-cli) & binary(build))",
    "(package(stitchwort-driver) & ((binary(navigation) & test(=references_of_a_project)) | (binary(named_arguments) & test(=named_calls_keep_every_hash))))",
    "(binary(extract) & test(=generated_code_is_stable))",
    "(binary(aoc_answers) & test(/^(year2021_day(01|03|07)|year2024_day(01|02|03|04|05|07|09)|year2025_day(01|03|05|07))$/))",
]


def one_line(s):
    return " ".join(s.split())


def generated(text):
    cfg = tomllib.loads(text)["profile"]
    lanes = [p for p in cfg if p.startswith("lane-") and p not in NOT_IN_MERGE]
    parts = ["(%s)" % one_line(cfg[p]["default-filter"]) for p in lanes] + EXTRAS
    return '"""\n' + "\n| ".join(parts) + '\n"""'


def rewrite(text):
    pat = re.compile(r'(\[profile\.merge\]\n(?:(?!\n\[).)*?default-filter = )""".*?"""', re.S)
    if not pat.search(text):
        sys.exit("nextest-merge: no [profile.merge] default-filter found")
    return pat.sub(lambda m: m.group(1) + generated(text), text, count=1)


def main():
    text = open(NEXTEST).read()
    new = rewrite(text)
    if "--check" in sys.argv:
        if new != text:
            sys.exit("nextest-merge: the merge profile's default-filter is out of date with the lane profiles; run dev/nextest-merge")
        return
    open(NEXTEST, "w").write(new)


if __name__ == "__main__":
    main()
