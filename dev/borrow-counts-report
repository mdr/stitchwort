#!/usr/bin/env python3
"""Turns dev/borrow-counts results into the stage B0 tables of
docs/proposals/borrow-inference.md (SW-2530): reference-count operations
borrowing would remove, converted to an estimated share of the native
program's instructions.

  python3 -I dev/borrow-counts-report --bench bench.json --instructions b0.json \
      [--aoc aoc.json --aoc-native sweep.json] [--variants b1,b1-no-o6,b2-no-o6]

Per-operation costs, native instructions (measured by micro-benchmark,
docs/performance/log.md, SW-2530): one inc plus one dec of a counted cell
costs 17 more than the same pair on a number; a pair on a number costs
about 10 (the check that the value holds a reference, twice). So a counted
operation is estimated at 13.5 and a plain one at 5; --low and --high give
the range.
"""

import argparse
import json
import math
import statistics

COSTS = {"low": (8.5, 0.0), "mid": (13.5, 5.0), "high": (18.0, 9.5)}


def saved(record, cost):
    counted_ops = record["net_inc"] + record["net_dec"]
    any_ops = record["net_inc_any"] + record["net_dec_any"]
    c, p = cost
    return counted_ops * c + (any_ops - counted_ops) * p


def load(path):
    return json.load(open(path)) if path else []


def by_label(records):
    out = {}
    for r in records:
        out.setdefault(r["label"], {})[r["variant"]] = r
    return out


def row(label, variants, recs, native, cost):
    cells = []
    for v in variants:
        r = recs.get(v)
        if not r or r.get("status") != "ok" or "net_inc" not in r:
            cells.append("n/a")
            continue
        pct = 100 * saved(r, cost) / native if native else math.nan
        cells.append(f"{(r['net_inc'] + r['net_dec']) / 2e6:.2f} M | {pct:.2f}%")
    return f"| {label} | " + " | ".join(cells) + " |"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bench")
    ap.add_argument("--instructions")
    ap.add_argument("--aoc")
    ap.add_argument("--aoc-native")
    ap.add_argument("--variants", default="b1,b1-no-o6,b2-no-o6")
    ap.add_argument("--cost", default="mid", choices=COSTS)
    opts = ap.parse_args()
    variants = opts.variants.split(",")
    cost = COSTS[opts.cost]
    head = "| Program | " + " | ".join(f"{v} pairs | {v} saved" for v in variants) + " |"
    rule = "|---|" + "---:|---:|" * len(variants)
    native = json.load(open(opts.instructions))["programs"] if opts.instructions else {}
    print(f"Cost per counted/plain operation: {cost} instructions\n")
    print(head)
    print(rule)
    bench = by_label(load(opts.bench))
    for label, recs in bench.items():
        n = native.get(label, {}).get("median")
        print(row(label, variants, recs, n, cost))
    if opts.aoc:
        days = json.load(open(opts.aoc_native))["days"] if opts.aoc_native else {}
        aoc = by_label(load(opts.aoc))
        print()
        print(head)
        print(rule)
        pcts = {v: [] for v in variants}
        for label, recs in sorted(aoc.items()):
            day = label.split()[1]
            n = days.get(day, {}).get("instructions")
            print(row(label, variants, recs, n, cost))
            for v in variants:
                r = recs.get(v)
                if n and r and r.get("status") == "ok" and "net_inc" in r:
                    pcts[v].append(100 * saved(r, cost) / n)
        print()
        for v in variants:
            if pcts[v]:
                print(f"{v}: {len(pcts[v])} days, median {statistics.median(pcts[v]):.2f}%, "
                      f"mean {statistics.mean(pcts[v]):.2f}%, max {max(pcts[v]):.2f}%")


if __name__ == "__main__":
    main()
