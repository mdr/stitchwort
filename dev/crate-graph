#!/usr/bin/env python3
"""Graphviz source for the crate diagram (docs/architecture/crates.typ).

  dev/crate-graph [--metadata FILE] [--out FILE]

Reads the workspace from `cargo metadata --no-deps` (run here, or read from
FILE) and writes a .dot file: one box per workspace crate, grouped by layer,
with an arrow for each normal dependency between workspace crates. Edges
already implied by a longer path are left out (transitive reduction), so the
picture shows the structure, not every `use`. Dev-dependencies are not drawn.
Optional edges (feature-gated) are dashed. Crates in the closure of the web
playground's dependencies are marked as part of the WebAssembly build.

Sizes are counted from the files: Rust lines in src/, in tests and other
targets, and .sw lines. Responsibilities and layers are written below; the
script stops if a workspace crate has none, so a new crate can't be missed.
Render with docs/architecture/build.sh.
"""
import argparse, json, math, os, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# crate -> (layer, responsibility lines)
INFO = {
    "syntax": ("front", ["Lexer, parser, surface", "AST, spans, diagnostics"]),
    "fmt": ("front", ["Source formatter; reparses", "its output to check it"]),
    "core": ("kernel", ["Core terms, evaluator (NbE),", "kernel checker, termination"]),
    "elab": ("elab", ["Surface syntax to core terms:", "names, inference, patterns,", "derives; the .sw std library"]),
    "driver": ("orch", ["Sessions, projects, check", "cache, search, tests,", "diagnostics; shared by", "CLI and browser"]),
    "rt": ("back", ["Fast untrusted runtime:", "erasure, IR, optimiser,", "bytecode machine, native ABI"]),
    "js": ("back", ["JavaScript extraction", "and TypeScript boundary"]),
    "native": ("back", ["Cranelift: JIT for", "run --native, objects", "for build"]),
    "host": ("back", ["Terminal handling and", "the big-stack thread"]),
    "standalone": ("back", ["Runtime a built exe links:", "C main, machine, host"]),
    "cli": ("iface", ["The stitchwort command:", "run, check, test, build,", "search, doc, fmt, LSP"]),
    "web": ("iface", ["Browser playground: the", "compiler as WebAssembly,", "JSON API"]),
    "bench": ("tool", ["Recorded benchmarks:", "work, allocation, time", "against a baseline"]),
    "partial-model": ("tool", ["Executable model of the", "Partial runtime proposal;", "driver tests only"]),
}
LAYERS = [
    ("iface", "Interfaces"),
    ("orch", "Orchestration"),
    ("back", "Runtime and backends"),
    ("elab", "Elaboration"),
    ("kernel", "Kernel"),
    ("front", "Front end"),
    ("tool", "Tooling"),
]
# Rows of the picture, top to bottom; the order inside a row is left to right.
ROWS = [
    ["cli", "web", "bench"],
    ["driver", "elab", "partial-model"],
    ["standalone", "native", "js"],
    ["host", "rt"],
    ["fmt", "syntax", "core"],
]
# Not a Cargo edge: `stitchwort build` links the standalone static library.
LINKED = [("cli", "standalone")]


def lines(paths):
    n = 0
    for p in paths:
        try:
            n += len(p.read_bytes().splitlines())
        except OSError:
            pass
    return n


def sizes(d):
    rs = [p for p in d.rglob("*.rs") if "target" not in p.parts]
    src = [p for p in rs if "src" in p.relative_to(d).parts[:1]]
    sw = [p for p in d.rglob("*.sw") if "target" not in p.parts]
    return lines(src), lines(rs) - lines(src), lines(sw)


def k(n):
    return f"{n / 1000:.1f}k" if n >= 1000 else str(n)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--metadata")
    ap.add_argument("--out")
    a = ap.parse_args()
    if a.metadata:
        meta = json.load(open(a.metadata))
    else:
        meta = json.loads(subprocess.check_output(
            ["cargo", "metadata", "--format-version", "1", "--no-deps"], cwd=ROOT))
    pk = {p["name"].removeprefix("stitchwort-"): p for p in meta["packages"]}
    missing = set(pk) - set(INFO)
    if missing:
        sys.exit(f"dev/crate-graph: no layer/responsibility for {sorted(missing)}")
    edges = {}  # (from, to) -> optional
    for n, p in pk.items():
        for d in p["dependencies"]:
            m = d["name"].removeprefix("stitchwort-")
            if d["name"].startswith("stitchwort-") and d["kind"] is None:
                edges[(n, m)] = edges.get((n, m), True) and d["optional"]
    succ = {n: {m for (x, m) in edges if x == n} for n in pk}

    def reach(n, skip=None):
        seen, todo = set(), [n]
        while todo:
            for m in succ[todo.pop()]:
                if (m, ) and m not in seen:
                    seen.add(m)
                    todo.append(m)
        return seen

    def implied(x, y):  # y reachable from x other than by the direct edge
        seen, todo = set(), [m for m in succ[x] if m != y]
        while todo:
            m = todo.pop()
            if m == y:
                return True
            if m not in seen:
                seen.add(m)
                todo.extend(succ[m])
        return False

    shown = {e: o for e, o in edges.items() if not implied(*e)}
    wasm = reach("web") | {"web"}
    sz = {n: sizes(ROOT / "crates" / n) for n in pk}
    big = max(s[0] for s in sz.values())

    out = ['digraph crates {',
           '  rankdir=TB; newrank=true; nodesep=0.18; ranksep=0.42; splines=true;',
           '  node [shape=plaintext fontname="Helvetica" fontsize=9];',
           '  edge [color="#555555" arrowsize=0.6 penwidth=1.1];']
    for layer, title in LAYERS:
        members = [n for n in pk if INFO[n][0] == layer]
        if not members:
            continue
        out.append(f'  subgraph "cluster_{layer}" {{ label=<<B>{title.upper()}</B>> labeljust=l labelloc=t '
                   f'fontname="Helvetica" fontsize=9 fontcolor="#777777" style="rounded,filled" '
                   f'color="#cccccc" fillcolor="#f6f6f6" margin=7;')
        for n in members:
            src, tests, sw = sz[n]
            bar = max(3, round(40 * math.sqrt(src / big)))
            border, bg = ("#b00020", "#fff1f1") if n == "core" else ("#444444", "white")
            sizetxt = f"src {k(src)}" + (f" + {k(tests)} tests" if tests >= 100 else "")
            if sw >= 1000:
                sizetxt += f" · {k(sw)} .sw"
            resp = "".join(f'<BR ALIGN="LEFT"/>{l}' for l in INFO[n][1])[len('<BR ALIGN="LEFT"/>'):]
            tags = []
            if n == "core":
                tags.append('<FONT COLOR="#b00020"><B>TRUSTED KERNEL</B></FONT>')
            if n in wasm:
                tags.append('<FONT COLOR="#1a5fb4">wasm</FONT>')
            tagcell = f'<TD ALIGN="RIGHT"><FONT POINT-SIZE="7.5">{"  ".join(tags) or " "}</FONT></TD>'
            out.append(
                f'    {n.replace("-", "_")} [label=<<TABLE BORDER="1" COLOR="{border}" CELLBORDER="0" '
                f'CELLSPACING="0" CELLPADDING="1" BGCOLOR="{bg}">'
                f'<TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="12">{n}</FONT></B></TD>{tagcell}</TR>'
                f'<TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="8.5">{resp}<BR ALIGN="LEFT"/></FONT></TD></TR>'
                f'<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8" COLOR="#555555">{sizetxt}</FONT></TD>'
                f'<TD ALIGN="RIGHT"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="0">'
                f'<TR><TD WIDTH="{bar}" HEIGHT="5" FIXEDSIZE="TRUE" BGCOLOR="#4a7ab5"></TD></TR></TABLE></TD></TR>'
                f'</TABLE>>];')
        out.append('  }')
    for row in ROWS:
        out.append("  { rank=same; " + " ".join(n.replace("-", "_") for n in row) + "; }")
        for a_, b_ in zip(row, row[1:]):
            out.append(f'  {a_.replace("-", "_")} -> {b_.replace("-", "_")} [style=invis];')
    for (x, y), opt in sorted(shown.items()):
        style = ' [style=dashed color="#c05800" fontcolor="#c05800" fontsize=7 label="feature native"]' if opt else ""
        out.append(f'  {x.replace("-", "_")} -> {y.replace("-", "_")}{style};')
    for x, y in LINKED:
        out.append(f'  {x} -> {y} [style=dotted color="#2a7f3f" arrowhead=odot];')
    out.append('}')
    text = "\n".join(out) + "\n"
    if a.out:
        Path(a.out).write_text(text)
    else:
        print(text)
    # What was drawn, for the legend and for checking.
    print(f"# {len(edges)} workspace edges, {len(shown)} drawn; wasm: {sorted(wasm)}", file=sys.stderr)


main()
