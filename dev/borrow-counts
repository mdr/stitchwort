#!/usr/bin/env python3
"""Stage B0 of docs/proposals/borrow-inference.md (SW-2530): runs programs on
the machine in a `--features borrow-counts` build of `stitchwort`, which prints
how many reference-count operations borrowed parameters would save, and
writes one JSON record per program and variant.

  cargo build --release -p stitchwort-cli --features borrow-counts
  python3 -I dev/borrow-counts --sw target/release/stitchwort --out OUT.json \
      [--variants b1,b1-no-o6,b2-no-o6] [--jobs 3] [--timeout 600] \
      [--bench] [--aoc 2021/15,2024/06,...] [names...]

`--bench` runs the bench/compare programs of the core and wide sets (or the
`names` given). Output is checked against expected.txt for those. The
variants are the rule sets in `stitchwort_rt::borrow::Variant`. The counter
is in the machine, so each run takes several times as long as the native
program.
"""

import argparse
import concurrent.futures
import importlib.util
import json
import os
import subprocess
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
_spec = importlib.util.spec_from_file_location("compare", ROOT / "bench" / "compare" / "compare.py")
compare = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(compare)


def parse(stderr):
    """The counters on a run's standard error."""
    out = {"codes": []}
    for line in stderr.splitlines():
        if line.startswith("borrow-dynamic "):
            if "net_inc=" in line:
                out["machines"] = out.get("machines", 0) + 1
            for item in line.split()[1:]:
                key, value = item.split("=")
                out[key] = int(value)
        elif line.startswith("borrow-static "):
            rest = line[len("borrow-static "):]
            if rest.startswith("owned-by "):
                key, value = rest[len("owned-by "):].rsplit("=", 1)
                out.setdefault("owned_by", {})[key] = int(value)
            elif rest.startswith("functions="):
                for item in rest.split():
                    key, value = item.split("=")
                    out[key] = int(value)
        elif line.startswith("borrow-code "):
            out["codes"].append(line[len("borrow-code "):])
    return out


def run_one(sw, label, argv, cwd, stdin_path, variant, timeout, expected):
    env = dict(os.environ, STITCHWORT_BORROW_COUNTS="1", STITCHWORT_BORROW_VARIANT=variant)
    start = time.monotonic()
    stdin = open(stdin_path, "rb") if stdin_path else subprocess.DEVNULL
    try:
        done = subprocess.run(argv, cwd=cwd, env=env, stdin=stdin, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"label": label, "variant": variant, "status": "timeout", "seconds": timeout}
    finally:
        if stdin_path:
            stdin.close()
    record = parse(done.stderr.decode(errors="replace"))
    record.update(label=label, variant=variant, seconds=round(time.monotonic() - start, 1))
    record["status"] = "ok" if done.returncode == 0 else "run-fail"
    if expected is not None and done.stdout != expected:
        record["status"] = "wrong-output"
    return record


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--sw", required=True, type=Path)
    parser.add_argument("--out", required=True, type=Path)
    parser.add_argument("--variants", default="b1,b1-no-o6,b2-no-o6")
    parser.add_argument("--jobs", type=int, default=2)
    parser.add_argument("--timeout", type=float, default=600)
    parser.add_argument("--bench", action="store_true")
    parser.add_argument("--aoc", default="")
    parser.add_argument("names", nargs="*")
    opts = parser.parse_args()
    jobs = []
    variants = opts.variants.split(",")
    sw = str(opts.sw.resolve())
    if opts.bench:
        entries = tomllib.loads((ROOT / "bench/compare/programs.toml").read_text())
        for name, entry in entries.items():
            if name == "null" or (opts.names and name not in opts.names):
                continue
            program = compare.Program(name, entry)
            args = ["--"] + program.args if program.args else []
            if program.is_file:
                argv, cwd = [sw, "run", str(ROOT / program.target)] + args, ROOT
            else:
                argv, cwd = [sw, "run", program.target] + args, ROOT / "aoc"
            for v in variants:
                jobs.append((name, argv, cwd, program.input, v, program.expected))
    for day in filter(None, opts.aoc.split(",")):
        year, number = day.split("/")
        if not (ROOT / "aoc" / "inputs" / year / f"day{number}.txt").exists():
            print(f"{day}: no committed input, skipped")
            continue
        argv = [sw, "run", f"Aoc.Year{year}.Day{number}.main"]
        for v in variants:
            jobs.append((f"aoc {year}/{number}", argv, ROOT / "aoc", ROOT / "aoc" / "inputs" / year / f"day{number}.txt", v, None))
    results = []
    with concurrent.futures.ThreadPoolExecutor(opts.jobs) as pool:
        futures = [pool.submit(run_one, sw, j[0], j[1], j[2], j[3], j[4], opts.timeout, j[5]) for j in jobs]
        for future in concurrent.futures.as_completed(futures):
            r = future.result()
            results.append(r)
            print(f"{r['label']:20} {r['variant']:10} {r['status']:12} {r.get('seconds')}s "
                  f"net_inc={r.get('net_inc')} net_dec={r.get('net_dec')} base={r.get('base_inc')}/{r.get('base_dec')}",
                  flush=True)
            opts.out.write_text(json.dumps(results, indent=1))


if __name__ == "__main__":
    main()
