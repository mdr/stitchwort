{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stitchwort",
  "scopeName": "source.stitchwort",
  "patterns": [
    { "include": "#comment" },
    { "include": "#definition" },
    { "include": "#auto" },
    { "include": "#string-block" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#keyword" },
    { "include": "#number" },
    { "include": "#type-name" },
    { "include": "#hole" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-dash.stitchwort",
      "match": "--.*$"
    },
    "definition": {
      "match": "\\b(def|theorem)\\b\\s+([A-Za-z][A-Za-z0-9_']*)",
      "captures": {
        "1": { "name": "keyword.control.stitchwort" },
        "2": { "name": "entity.name.function.stitchwort" }
      }
    },
    "auto": {
      "match": "(?<=\\[)\\s*(auto)(?![A-Za-z0-9_'])",
      "captures": { "1": { "name": "keyword.control.stitchwort" } }
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.stitchwort",
          "match": "\\b(type|theorem|def|export|test|interface|instance|if|then|else|ability|where|handle|with|match|return|let|import|namespace|calc|rewrite|omega|ring|cases|decreasing|opaque|unfolding)(?![A-Za-z0-9_'])"
        },
        {
          "comment": "`in` (or `∈`, an operator below) and `exists` (or `∃`); `exists` after a `.` is a call, `opt.exists p`",
          "name": "keyword.control.stitchwort",
          "match": "(?<![.A-Za-z0-9_'!])(in|exists)(?![A-Za-z0-9_'])|∃"
        },
        {
          "name": "support.type.stitchwort",
          "match": "\\b(Type|Prop)(?![A-Za-z0-9_'])"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.stitchwort",
      "match": "\\\\(?:[ntr\\\\\"'$]|u\\{[0-9A-Fa-f]+\\})"
    },
    "interpolation": {
      "name": "meta.interpolation.stitchwort",
      "begin": "\\$\\{",
      "end": "\\}|$",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.stitchwort" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.stitchwort" }
      },
      "contentName": "meta.embedded.line.stitchwort",
      "patterns": [
        { "include": "#braces" },
        { "include": "$self" }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#braces" },
        { "include": "$self" }
      ]
    },
    "string-block": {
      "name": "string.quoted.triple.stitchwort",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#escape" },
        { "name": "invalid.illegal.escape.stitchwort", "match": "\\\\." }
      ]
    },
    "string": {
      "name": "string.quoted.double.stitchwort",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#escape" },
        { "name": "invalid.illegal.escape.stitchwort", "match": "\\\\." }
      ]
    },
    "char": {
      "name": "string.quoted.single.stitchwort",
      "begin": "(?<![A-Za-z0-9_'])'",
      "end": "'|$",
      "patterns": [
        { "include": "#escape" },
        { "name": "invalid.illegal.escape.stitchwort", "match": "\\\\." }
      ]
    },
    "number": {
      "patterns": [
        {
          "comment": "A '-' glued to a numeral, with no closing character touching it on the left, is part of the number (docs/proposals/negative-arguments.md): -1.abs is (-1).abs, but x-1 subtracts.",
          "name": "constant.numeric.stitchwort",
          "match": "(?<![A-Za-z0-9_')\\]}\"])-[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.stitchwort",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "type-name": {
      "name": "entity.name.type.stitchwort",
      "match": "\\b[A-Z][A-Za-z0-9_']*"
    },
    "hole": {
      "name": "keyword.control.hole.stitchwort",
      "match": "\\?"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.stitchwort",
          "match": ":=|=>|<->|->|\\|>|\\|\\||&&|==|!=|!in(?![A-Za-z0-9_'])|<=|\\+\\+|\\.\\.|[=<+\\-*/%|:]|[∈∉→↔∧∨¬≤≥≠]"
        },
        { "name": "punctuation.separator.stitchwort", "match": "[,.]" }
      ]
    }
  }
}
