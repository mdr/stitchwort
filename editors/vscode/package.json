{
  "name": "stitchwort",
  "displayName": "Stitchwort",
  "description": "Syntax colouring and, through the `stitchwort lsp` language server, diagnostics as you type, go to definition, hover, references and outline for Stitchwort (.sw) files",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:stitchwort", "workspaceContains:**/stitchwort.yaml"],
  "dependencies": { "vscode-languageclient": "9.0.1" },
  "contributes": {
    "commands": [
      { "command": "stitchwort.showGoals", "title": "Stitchwort: Show Goals" },
      { "command": "stitchwort.restartServer", "title": "Stitchwort: Restart Server" }
    ],
    "languages": [
      {
        "id": "stitchwort",
        "aliases": ["Stitchwort", "stitchwort"],
        "extensions": [".sw"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stitchwort",
        "scopeName": "source.stitchwort",
        "path": "./syntaxes/stitchwort.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      { "id": "theorem", "superType": "function", "description": "A theorem, or a proof of one" },
      { "id": "ability", "superType": "interface", "description": "An ability (an effect) and its operations' namespace" }
    ],
    "semanticTokenScopes": [
      {
        "language": "stitchwort",
        "scopes": {
          "theorem": ["entity.name.function.theorem.stitchwort"],
          "ability": ["entity.name.type.interface.stitchwort"]
        }
      }
    ],
    "configuration": {
      "title": "Stitchwort",
      "properties": {
        "stitchwort.path": {
          "type": "string",
          "default": "stitchwort",
          "scope": "machine",
          "markdownDescription": "The `stitchwort` command line program. The extension starts `stitchwort lsp` from it, and reads library source with `stitchwort std-source`. A bare name is looked up on PATH."
        }
      }
    }
  }
}
